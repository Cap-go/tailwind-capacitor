{
  "name": "@capgo/tailwind-capacitor",
  "version": "5.0.0",
  "description": "Tailwind plugin for Capacitor apps",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./vue": "./src/vue/capacitor-vue.js",
    "./base": "./src/config/plugin-base.js",
    "./colors": "./src/config/plugin-colors.js",
    "./hairlines": "./src/config/plugin-hairlines.js",
    "./ios-material": "./src/config/plugin-ios-material.js",
    "./line-clamp": "./src/config/plugin-line-clamp.js",
    "./no-scrollbar": "./src/config/plugin-no-scrollbar.js",
    "./preloader": "./src/config/plugin-preloader.js",
    "./range": "./src/config/plugin-range.js",
    "./safe-areas": "./src/config/plugin-safe-areas.js",
    "./touch-ripple": "./src/config/plugin-touch-ripple.js",
    "./touch": "./src/config/plugin-touch.js",
    "./translucent": "./src/config/plugin-translucent.js",
    "./platform": "./src/config/plugin-platform.js"
  },
  "scripts": {
    "lint": "eslint .",
    "generate:css": "node scripts/copy-capacitor-config.mjs && node scripts/generate-line-clamp-css.mjs && node scripts/generate-safe-area-css.mjs",
    "generate:registry": "node scripts/generate-registry.mjs",
    "build:registry": "npm run generate:css && npm run generate:registry && shadcn build -o public/r",
    "postprocess:registry": "node scripts/postprocess-registry.mjs",
    "test": "node scripts/verify-safe-area-selectors.js",
    "test:registry-install": "node scripts/test-registry-install.mjs",
    "smoke:tailwind": "node scripts/smoke-tailwind-v4.mjs",
    "build:example": "npm run sync:example && npm run build:example:app",
    "sync:example": "node scripts/sync-example-registry.mjs && node scripts/generate-example-barrel.mjs",
    "build:example:app": "npm --prefix example run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/tailwind-capacitor.git"
  },
  "keywords": [
    "tailwind",
    "capacitor",
    "plugin"
  ],
  "author": "Martin Donadieu (martin@capgo.app)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Cap-go/tailwind-capacitor/issues"
  },
  "homepage": "https://github.com/Cap-go/tailwind-capacitor#readme",
  "files": [
    "index.js",
    "src",
    "registry",
    "registry.json",
    "public/r",
    "components.json"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "playwright": "^1.51.0",
    "postcss": "^8.5.6",
    "shadcn": "^3.2.1",
    "tailwindcss": "^4.1.11"
  }
}
