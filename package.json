{
  "name": "@capgo/tailwind-capacitor",
  "version": "5.0.0",
  "description": "Tailwind plugin for Capacitor apps",
  "main": "index.js",
  "bin": {
    "registry-add": "scripts/registry-add.mjs",
    "tailwind-capacitor-registry-add": "scripts/registry-add.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./vue": "./src/vue/capacitor-vue.js",
    "./base": "./src/config/plugin-base.js",
    "./colors": "./src/config/plugin-colors.js",
    "./hairlines": "./src/config/plugin-hairlines.js",
    "./ios-material": "./src/config/plugin-ios-material.js",
    "./line-clamp": "./src/config/plugin-line-clamp.js",
    "./no-scrollbar": "./src/config/plugin-no-scrollbar.js",
    "./preloader": "./src/config/plugin-preloader.js",
    "./range": "./src/config/plugin-range.js",
    "./safe-areas": "./src/config/plugin-safe-areas.js",
    "./touch-ripple": "./src/config/plugin-touch-ripple.js",
    "./touch": "./src/config/plugin-touch.js",
    "./translucent": "./src/config/plugin-translucent.js",
    "./platform": "./src/config/plugin-platform.js"
  },
  "scripts": {
    "lint": "eslint .",
    "generate:css": "node scripts/copy-capacitor-config.mjs && node scripts/generate-line-clamp-css.mjs && node scripts/generate-safe-area-css.mjs",
    "generate:registry": "node scripts/scaffold-ionic-additions.mjs && node scripts/port-konsta-react.mjs && node scripts/generate-shared-dts.mjs && node scripts/generate-angular-components.mjs && node scripts/generate-angular-icons.mjs && node scripts/generate-registry.mjs",
    "build:registry:vue": "npx shadcn build -o public/r registry.json",
    "build:registry:react": "npx shadcn build -o public/r/react registry-react.json",
    "build:registry:angular": "npx shadcn build -o public/r/angular registry-angular.json",
    "build:registry": "npm run generate:css && npm run generate:registry && npm run build:registry:vue && npm run build:registry:react && npm run build:registry:angular && node scripts/mirror-vue-registry.mjs && REGISTRY_BRANCH=main node scripts/postprocess-registry.mjs",
    "test:registry-install:vue": "REGISTRY_FRAMEWORK=vue node scripts/test-registry-install.mjs",
    "test:registry-install:react": "REGISTRY_FRAMEWORK=react node scripts/test-registry-install.mjs",
    "test:registry-install:angular": "REGISTRY_FRAMEWORK=angular node scripts/test-registry-install.mjs",
    "test:angular-full": "node scripts/test-angular-full.mjs",
    "test:angular-strict-build": "node scripts/test-angular-full.mjs",
    "test:react-full": "node scripts/test-react-full.mjs",
    "test:vue-full": "node scripts/test-vue-full.mjs",
    "test:readme-install": "node scripts/test-readme-install.mjs",
    "verify:registry-refs": "node scripts/verify-registry-refs.mjs",
    "postprocess:registry": "node scripts/postprocess-registry.mjs",
    "pretest": "npm run generate:css",
    "test": "node scripts/verify-safe-area-selectors.js && node scripts/test-use-effective-dark.mjs && node scripts/test-angular-gen.mjs",
    "test:registry-install": "npm run test:registry-install:vue && npm run test:registry-install:react && npm run test:registry-install:angular",
    "smoke:tailwind": "node scripts/smoke-tailwind-v4.mjs",
    "build:example": "npm run sync:example && npm run build:example:app",
    "sync:example": "node scripts/sync-example-registry.mjs && node scripts/generate-example-barrel.mjs",
    "build:example:app": "npm --prefix example run build",
    "build:example-react": "node scripts/build-example-react.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "capture:screenshots:after": "CAPTURE_AFTER_ONLY=1 node scripts/capture-screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/tailwind-capacitor.git"
  },
  "keywords": [
    "tailwind",
    "capacitor",
    "plugin"
  ],
  "author": "Martin Donadieu (martin@capgo.app)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Cap-go/tailwind-capacitor/issues"
  },
  "homepage": "https://github.com/Cap-go/tailwind-capacitor#readme",
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "files": [
    "index.js",
    "scripts/registry-add.mjs",
    "scripts/repo-root.mjs",
    "src",
    "registry",
    "registry.json",
    "public/r",
    "components.json"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "playwright": "^1.51.0",
    "typescript": "^5.8.3",
    "postcss": "^8.5.6",
    "shadcn": "^3.2.1",
    "tailwindcss": "^4.1.11"
  }
}
