{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "capacitor-notification",
  "type": "registry:item",
  "title": "Capacitor Notification",
  "description": "Capacitor Notification Vue component.",
  "dependencies": [
    "vue"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/cursor/tailwind-v4-shadcn-registry-0cd5/public/r/capacitor-tailwind.json",
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/cursor/tailwind-v4-shadcn-registry-0cd5/public/r/capacitor-provider.json",
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/cursor/tailwind-v4-shadcn-registry-0cd5/public/r/capacitor-shared.json"
  ],
  "files": [
    {
      "path": "src/vue/components/Notification.vue",
      "content": "<template>\n  <component :is=\"component\" v-if=\"theme === 'ios'\" ref=\"elRef\" :class=\"c.base\">\n    <div :class=\"c.header\">\n      <div v-if=\"icon || slots.icon\" :class=\"c.icon\">\n        {{ icon }}<slot name=\"icon\" />\n      </div>\n      <div v-if=\"title || slots.title\" :class=\"c.title\">\n        {{ title }}<slot name=\"title\" />\n      </div>\n      <div\n        v-if=\"titleRightText || slots.titleRightText\"\n        :class=\"c.titleRightText\"\n      >\n        {{ titleRightText }}<slot name=\"titleRightText\" />\n      </div>\n      <div\n        v-if=\"button || slots.button\"\n        :class=\"c.button\"\n        role=\"button\"\n        tabindex=\"0\"\n        @click=\"onClose\"\n      >\n        <delete-icon :theme=\"theme\" :class=\"c.deleteIcon\" />\n        <slot name=\"button\" />\n      </div>\n    </div>\n    <div :class=\"c.content\">\n      <div v-if=\"subtitle || slots.subtitle\" :class=\"c.subtitle\">\n        {{ subtitle }}<slot name=\"subtitle\" />\n      </div>\n      <div v-if=\"text || slots.text\" :class=\"c.text\">\n        {{ text }}<slot name=\"text\" />\n      </div>\n      <slot />\n    </div>\n  </component>\n  <component :is=\"component\" v-else ref=\"elRef\" :class=\"c.base\">\n    <div :class=\"c.header\">\n      <div v-if=\"icon || slots.icon\" :class=\"c.icon\">\n        {{ icon }}<slot name=\"icon\" />\n      </div>\n      <div :class=\"c.contentWrapper\">\n        <div :class=\"c.contentTitle\">\n          <div v-if=\"title || slots.title\" :class=\"c.title\">\n            {{ title }}<slot name=\"title\" />\n          </div>\n          <div\n            v-if=\"titleRightText || slots.titleRightText\"\n            :class=\"c.titleRightText\"\n          >\n            {{ titleRightText }}<slot name=\"titleRightText\" />\n          </div>\n        </div>\n        <div :class=\"c.content\">\n          <div v-if=\"subtitle || slots.subtitle\" :class=\"c.subtitle\">\n            {{ subtitle }}<slot name=\"subtitle\" />\n          </div>\n          <div v-if=\"text || slots.text\" :class=\"c.text\">\n            {{ text }}<slot name=\"text\" />\n          </div>\n          <slot />\n        </div>\n      </div>\n      <div\n        v-if=\"button || slots.button\"\n        :class=\"c.button\"\n        role=\"button\"\n        tabindex=\"0\"\n        @click=\"onClose\"\n      >\n        <delete-icon :theme=\"theme\" :class=\"c.deleteIcon\" />\n        <slot name=\"button\" />\n      </div>\n    </div>\n  </component>\n</template>\n<script>\n  import { computed } from 'vue';\n  import { useContext } from '../shared/use-context.js';\n\n  import { NotificationsClasses } from '../../shared/classes/NotificationsClasses.js';\n\n  import { NotificationsColors } from '../../shared/colors/NotificationsColors.js';\n\n  import { darkClasses } from '../shared/use-dark-classes.js';\n\n  import { themeClasses } from '../shared/use-theme-classes.js';\n\n  import { useTheme } from '../shared/use-theme.js';\n  import DeleteIcon from './icons/DeleteIcon.vue';\n\n  export default {\n    name: 'c-notification',\n    components: {\n      DeleteIcon,\n    },\n    props: {\n      component: {\n        type: String,\n        default: 'div',\n      },\n      colors: {\n        type: Object,\n      },\n      ios: {\n        type: Boolean,\n        default: undefined,\n      },\n      material: {\n        type: Boolean,\n        default: undefined,\n      },\n      opened: {\n        type: Boolean,\n        default: undefined,\n      },\n      translucent: {\n        type: Boolean,\n        default: true,\n      },\n      button: { type: String },\n      icon: { type: String },\n      title: { type: [String, Number] },\n      titleRightText: { type: [String, Number] },\n      subtitle: { type: [String, Number] },\n      text: { type: [String, Number] },\n    },\n    emits: ['close'],\n    setup(props, ctx) {\n      const context = useContext();\n      const useDarkClasses = darkClasses(context);\n      const useThemeClasses = themeClasses(context);\n      const theme = useTheme({}, context);\n\n      const colors = computed(() =>\n        NotificationsColors(props.colors || {}, useDarkClasses)\n      );\n\n      const c = useThemeClasses(props, () =>\n        NotificationsClasses(props, colors.value, ctx.attrs.class)\n      );\n      const onClose = () => {\n        ctx.emit('close');\n      };\n      return {\n        c,\n        theme,\n        onClose,\n        slots: ctx.slots,\n      };\n    },\n  };\n</script>\n",
      "type": "registry:file",
      "target": "src/capacitor/vue/components/Notification.vue"
    }
  ]
}
