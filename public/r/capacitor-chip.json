{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "capacitor-chip",
  "type": "registry:item",
  "title": "Capacitor Chip (Vue)",
  "description": "Capacitor Chip Vue component.",
  "dependencies": [
    "vue"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/main/public/r/capacitor-tailwind.json",
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/main/public/r/capacitor-provider.json",
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/main/public/r/capacitor-shared.json",
    "https://raw.githubusercontent.com/Cap-go/tailwind-capacitor/refs/heads/main/public/r/capacitor-icons.json"
  ],
  "files": [
    {
      "path": "src/vue/components/Chip.vue",
      "content": "<template>\n  <component :is=\"component\" :class=\"c.base[style]\">\n    <div v-if=\"slots.media\" :class=\"c.media\"><slot name=\"media\" /></div>\n    <slot />\n    <button\n      v-if=\"deleteButton\"\n      type=\"button\"\n      :class=\"c.deleteButton\"\n      :aria-label=\"deleteLabel\"\n      @click=\"onDelete\"\n    >\n      <delete-icon :theme=\"theme\" class=\"h-4 w-4\" />\n    </button>\n  </component>\n</template>\n<script>\n  import { computed } from 'vue';\n  import { useContext } from '../shared/use-context.js';\n\n  import { ChipClasses } from '../../shared/classes/ChipClasses.js';\n\n  import { ChipColors } from '../../shared/colors/ChipColors.js';\n\n  import { darkClasses } from '../shared/use-dark-classes.js';\n\n  import { useTheme } from '../shared/use-theme.js';\n\n  import { themeClasses } from '../shared/use-theme-classes.js';\n  import DeleteIcon from './icons/DeleteIcon.vue';\n\n  export default {\n    name: 'c-chip',\n    components: {\n      DeleteIcon,\n    },\n    props: {\n      component: {\n        type: String,\n        default: 'div',\n      },\n      colors: {\n        type: Object,\n      },\n      ios: {\n        type: Boolean,\n        default: undefined,\n      },\n      material: {\n        type: Boolean,\n        default: undefined,\n      },\n      deleteButton: {\n        type: Boolean,\n        default: false,\n      },\n      deleteLabel: {\n        type: String,\n        default: 'Remove',\n      },\n      outline: {\n        type: Boolean,\n        default: false,\n      },\n    },\n    emits: ['delete'],\n    setup(props, ctx) {\n      const context = useContext();\n      const useDarkClasses = darkClasses(context);\n      const useThemeClasses = themeClasses(context);\n      const style = computed(() => (props.outline ? 'outline' : 'fill'));\n      const theme = useTheme({}, context);\n\n      const colors = computed(() =>\n        ChipColors(props.colors || {}, useDarkClasses)\n      );\n\n      const c = useThemeClasses(props, () => ChipClasses(props, colors.value));\n\n      const onDelete = () => {\n        ctx.emit('delete');\n      };\n      return {\n        c,\n        slots: ctx.slots,\n        style,\n        theme,\n        onDelete,\n      };\n    },\n  };\n</script>\n",
      "type": "registry:file",
      "target": "src/capacitor/vue/components/Chip.vue"
    }
  ]
}
