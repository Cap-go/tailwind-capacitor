    {
      "path": "src/vue/components/Table.vue",
      "content": "<template>\n  <table ref=\"elRef\" :class=\"c.base\">\n    <slot />\n  </table>\n</template>\n<script>\n  import { ref } from 'vue';\n  import { useContext } from '../shared/use-context.js';\n\n  import { TableClasses } from '../../shared/classes/TableClasses.js';\n\n  import { themeClasses } from '../shared/use-theme-classes.js';\n\n  export default {\n    name: 'c-table',\n    props: {\n      ios: {\n        type: Boolean,\n        default: undefined,\n      },\n      material: {\n        type: Boolean,\n        default: undefined,\n      },\n    },\n    setup(props, ctx) {\n      const context = useContext();\n      const useThemeClasses = themeClasses(context);\n      const elRef = ref(null);\n\n      const c = useThemeClasses(props, () =>\n        TableClasses(\n          {\n            ...props,\n          },\n          ctx.attrs.class\n        )\n      );\n\n      return {\n        c,\n        elRef,\n      };\n    },\n  };\n</script>\n",
      "type": "registry:file",
      "target": "src/capacitor/vue/components/Table.vue"
    }
  ]
